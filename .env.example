# DSH Gateway
DSH_GATEWAY_KEY=your-dsh-gateway-key
DSH_GATEWAY_URL=http://localhost:8080

# Ollama (local brain)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud AI Gateway
CLOUD_GATEWAY_URL=http://localhost:80/v1
CLOUD_API_KEY=your-cloud-api-key

# run:ai GPU
GPU_BASE_URL=https://api.run.ai
GPU_TOKEN=your-runai-token
GPU_AGENT_POOL=your-pool-name
GPU_AGENT_IMAGE=nvidia/nemo:latest

# NVIDIA NIM
NIM_BASE_URL=https://ai.api.nvidia.com
NIM_API_KEY=your-nim-api-key

# Lark
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_VERIFICATION_TOKEN=your-lark-verification-token

# Server
PORT=3000
LOG_LEVEL=info
