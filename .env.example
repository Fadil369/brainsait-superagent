# ── Local brain (Ollama) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── Cloud AI Gateway brain ───────────────────────────────────────────
# Free local OpenAI-compatible endpoint on the aperture node (no auth)
CLOUD_GATEWAY_URL=http://100.86.164.23
CLOUD_API_BASE=
CLOUD_MODEL_PRIMARY=Qwen/Qwen3.6-35B-A3B-FP8
CLOUD_MODEL_FALLBACK=Qwen/Qwen3.8-27B
# Optional: BrainSAIT AI gateway (Cloudflare Access or DSH key required)
DSH_GATEWAY_KEY=
DSH_GATEWAY_URL=http://100.110.98.65/v1

# ── GPU brain (Brev) ─────────────────────────────────────────────────
BREV_API_KEY=your-brev-api-key
GPU_BASE_URL=https://api.brev.dev
GPU_TOKEN=your-brev-token
GPU_AGENT_POOL=h100
GPU_AGENT_IMAGE=nvcr.io/nvidia/doca/doca:2.7.0
GPU_ENABLED=true

# ── NVIDIA NIM brain (cloud) ─────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-nvidia-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODELS=

# ── NVIDIA Run:ai brain ──────────────────────────────────────────────
RUNAI_BASE_URL=https://your-runai-cluster
RUNAI_CLIENT_ID=your-client-id
RUNAI_CLIENT_SECRET=your-client-secret

# ── Lark ─────────────────────────────────────────────────────────────
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_VERIFICATION_TOKEN=your-lark-verification-token
LARK_WEBHOOK_PORT=3084

# ── Server ───────────────────────────────────────────────────────────
PORT=3083
LOG_LEVEL=info
