# ── Local brain (Ollama) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── Cloud AI Gateway brain ───────────────────────────────────────────
DSH_GATEWAY_KEY=your-dsh-gateway-key
DSH_GATEWAY_URL=http://100.110.98.65/v1
CLOUD_GATEWAY_URL=http://100.110.98.65/v1
CLOUD_API_KEY=your-cloud-api-key

# ── GPU brain (Brev) ─────────────────────────────────────────────────
BREV_API_KEY=your-brev-api-key
GPU_BASE_URL=https://api.brev.dev
GPU_TOKEN=your-brev-token
GPU_AGENT_POOL=h100
GPU_AGENT_IMAGE=nvcr.io/nvidia/doca/doca:2.7.0
GPU_ENABLED=true

# ── NVIDIA NIM brain (cloud) ─────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-nvidia-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODELS=

# ── NVIDIA Run:ai brain ──────────────────────────────────────────────
RUNAI_BASE_URL=https://your-runai-cluster
RUNAI_CLIENT_ID=your-client-id
RUNAI_CLIENT_SECRET=your-client-secret

# ── Lark ─────────────────────────────────────────────────────────────
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_VERIFICATION_TOKEN=your-lark-verification-token
LARK_WEBHOOK_PORT=3084

# ── Server ───────────────────────────────────────────────────────────
PORT=3083
LOG_LEVEL=info
