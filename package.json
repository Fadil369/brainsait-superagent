{
  "name": "@brainsait/superagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/web"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --import tsx/dist/cli.mjs src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit && eslint src/",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "lark": "tsx src/lark/server.ts",
    "memory": "tsx -e \"import {memory} from './src/memory/store.ts'; console.log(memory().stats())\""
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "5.7"
  }
}
